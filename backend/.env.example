# Приложение
APP_NAME=KEDO
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# MainBD — основная бизнес-БД
MAIN_DB_HOST=localhost
MAIN_DB_PORT=5432
MAIN_DB_USER=kedo
MAIN_DB_PASSWORD=changeme
MAIN_DB_NAME=kedo_main

# LogBD — контур аудита и безопасности
LOG_DB_HOST=localhost
LOG_DB_PORT=5432
LOG_DB_USER=kedo_log
LOG_DB_PASSWORD=changeme
LOG_DB_NAME=kedo_log

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Файловое хранилище
UPLOAD_DIR=./uploads
